---
import Base from "@/layouts/Base.astro";
import Prompt from "@/components/Prompt.astro";
import { categoryOf, formatDate, getPosts, toPlainText } from "@/lib/posts";

// 静的サイトなので、全記事のテキストをページに埋め込んでブラウザ内で検索する
const index = (await getPosts()).map((post) => {
  const category = categoryOf(post);
  return {
    id: post.id,
    title: post.data.title,
    date: formatDate(post.data.date),
    slug: category.slug,
    text: [post.data.title, category.slug, ...post.data.tags, toPlainText(post.body ?? "")].join(" "),
  };
});
---

<Base title="search">
  <section class="block">
    <Prompt>
      <span class="prompt-command">grep -ri "</span><input
        id="search-input"
        type="search"
        placeholder="keyword"
        aria-label="記事を検索"
        autocomplete="off"
        autofocus
      /><span class="prompt-command">" posts/</span>
    </Prompt>
    <div class="output">
      <p id="search-count" class="dim"></p>
      <ul id="search-results" class="grep-results"></ul>
    </div>
  </section>
  <script id="search-index" type="application/json" set:html={JSON.stringify(index)} />

  <script>
    type Item = { id: string; title: string; date: string; slug: string; text: string };

    const items: Item[] = JSON.parse(document.getElementById("search-index")!.textContent!);
    const input = document.getElementById("search-input") as HTMLInputElement;
    const count = document.getElementById("search-count")!;
    const list = document.getElementById("search-results")!;

    const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

    function highlight(text: string, q: string) {
      const lower = text.toLowerCase();
      let out = "";
      let pos = 0;
      for (let i = lower.indexOf(q); i !== -1; i = lower.indexOf(q, pos)) {
        out += escape(text.slice(pos, i)) + "<mark>" + escape(text.slice(i, i + q.length)) + "</mark>";
        pos = i + q.length;
      }
      return out + escape(text.slice(pos));
    }

    function search(raw: string) {
      const q = raw.trim().toLowerCase();
      history.replaceState(null, "", q ? `?q=${encodeURIComponent(raw.trim())}` : location.pathname);
      if (!q) {
        count.textContent = "";
        list.innerHTML = "";
        return;
      }

      const hits = items.flatMap((item) => {
        const i = item.text.toLowerCase().indexOf(q);
        if (i === -1) return [];
        const snippet = (i > 40 ? "…" : "") + item.text.slice(Math.max(0, i - 40), i + 80) + "…";
        return [{ item, snippet }];
      });

      count.textContent = `${hits.length} files matched`;
      list.innerHTML = hits
        .map(
          ({ item, snippet }) => `<li>
            <a href="/posts/${item.id}/" class="grep-file">posts/${escape(item.id)}.md</a>
            <span class="cat-tag">${item.slug}</span>
            <span class="dim">${item.date}</span>
            <a href="/posts/${item.id}/" class="grep-title">${highlight(item.title, q)}</a>
            <p class="grep-snippet">${highlight(snippet, q)}</p>
          </li>`,
        )
        .join("");
    }

    input.value = new URLSearchParams(location.search).get("q") ?? "";
    input.addEventListener("input", () => search(input.value));
    search(input.value);
  </script>
</Base>
